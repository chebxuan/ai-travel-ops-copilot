# Current backend configuration. Existing .env files are not modified.
API_KEY=replace-with-a-local-development-key
# Optional external API URL used for the OpenAPI server listing.
# PUBLIC_URL=https://your-api.example
# PostgreSQL credentials and roles are configured separately as documented
# in docs/database-guide.md. Never put private keys in NEXT_PUBLIC_*.

# Optional operations/notification settings: configure via scripts/configure_operations.py.
# OPS_BACKEND_KEY is separate from API_KEY. Credentials never enter client code.
# FEISHU_NOTIFICATIONS_ENABLED=0
# FEISHU_WEBHOOK_URL=
# FEISHU_SIGNING_SECRET=
# OPS_SITE_ORIGIN=https://your-site.example
