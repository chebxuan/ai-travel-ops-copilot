# Copy via: python3 deploy/configure.py --site http://SERVER_IP
# Never commit deploy/.env.production or print resolved Compose configuration.
SITE_ADDRESS=http://localhost
SITE_ORIGIN=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
APP_VERSION=local
API_KEY=GENERATE_ME
DB_ADMIN_PASSWORD=GENERATE_ME
DB_READER_PASSWORD=GENERATE_ME
DB_INTAKE_PASSWORD=GENERATE_ME

# Run scripts/configure_operations.py --target production on an existing configuration.
DB_OPS_PASSWORD=GENERATE_ME
DB_NOTIFICATION_PASSWORD=GENERATE_ME
OPS_BACKEND_KEY=GENERATE_ME
OPS_SESSION_KEY=GENERATE_ME
OPS_USERNAME=
OPS_PASSWORD_HASH=
# Start the notifications profile only after enabling and configuring the signed bot.
FEISHU_NOTIFICATIONS_ENABLED=0
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
